/**app.wxss - 一图知卡 全局视觉（温和、可信、有掌控感）*/
page {
  background: #faf7f4;               /* 暖白 */
  color: #2a2e31;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 28rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #faf7f4;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 20rpx 0;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(74, 58, 41, 0.06);
  border: 1rpx solid #f0ece7;
}

/* 主按钮：深绿色主操作 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 999rpx;
  background: #1f7a4d;              /* 深绿主操作 */
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 20rpx rgba(31, 122, 77, 0.22);
  transition: transform 0.12s ease, background 0.12s ease;
}
.btn-primary:active { background: #185f3b; transform: scale(0.98); }
.btn-primary[disabled] { background: #cdd4d0; box-shadow: none; color: #ffffff; }

/* 次要按钮 */
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4a4e52;
  font-size: 28rpx;
  border: 1rpx solid #e4ddd6;
  margin-top: 16rpx;
}
.btn-secondary:active { background: #f6f2ee; }

/* 文本链接（降低权重但仍可发现） */
.link { color: #1f7a4d; font-size: 26rpx; }

.title { font-size: 38rpx; font-weight: 700; color: #2a2e31; margin-bottom: 12rpx; }
.subtitle { font-size: 26rpx; color: #6b7280; }
.label { font-size: 28rpx; color: #6b7280; margin-top: 8rpx; }
.value { font-size: 34rpx; color: #1f7a4d; font-weight: 600; }
.warning { color: #e8833a; font-size: 26rpx; margin-top: 16rpx; }
.disclaimer { font-size: 24rpx; color: #9aa0a6; margin-top: 16rpx; text-align: center; line-height: 1.6; }

.input {
  border: 1rpx solid #e4ddd6;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
  margin: 12rpx 0;
}
