/**app.wxss**/
.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.btn-primary {
  background-color: #4CAF50;
  color: white;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 32rpx;
  text-align: center;
  margin: 20rpx 0;
}

.btn-primary[disabled] {
  background-color: #ccc;
  color: #999;
}

.card {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.value {
  font-size: 32rpx;
  color: #4CAF50;
  font-weight: 600;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

.warning {
  color: #ff6b35;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.disclaimer {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
  text-align: center;
}

.input {
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
  margin: 12rpx 0;
}
