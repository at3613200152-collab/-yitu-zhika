/* pages/nutritionist/nutritionist.wxss - 饮食计划 */
.container { padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); background: #faf7f4; min-height: 100vh; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(74,58,41,.06); }
.subtitle { font-size: 24rpx; color: #6b7280; line-height: 1.6; margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #2a2e31; margin: 24rpx 0 12rpx; }

.form-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f2eee9; }
.form-label { font-size: 28rpx; color: #4a4e52; flex: 0 0 150rpx; white-space: nowrap; }
.form-input { flex: 1 1 0%; width: 0; min-width: 0; box-sizing: border-box; height: 88rpx; padding: 0 16rpx; background: #faf7f4; border-radius: 12rpx; font-size: 28rpx; }
.form-picker { flex: 1 1 0%; min-width: 0; }
.picker { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; line-height: 1.5; box-sizing: border-box; padding: 12rpx 16rpx; background: #faf7f4; border-radius: 12rpx; font-size: 28rpx; }
.picker-value { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.picker-arrow { flex-shrink: 0; margin-left: 12rpx; color: #626c68; }
.choice-row { display: block; }
.choice-row .form-label { display: block; margin-bottom: 12rpx; }
.option-row { display: flex; gap: 12rpx; width: 100%; min-width: 0; }
.opt { display: flex; align-items: center; justify-content: center; flex: 1 1 0%; width: 0; min-width: 0; margin: 0; padding: 12rpx 8rpx; min-height: 88rpx; line-height: 1.4; text-align: center; border-radius: 14rpx; background: #f4f0eb; color: #4a4e52; font-size: 28rpx; font-weight: 500; border: 2rpx solid transparent; }
.opt-active { background: #eaf4ed; color: #1f7a4d; border-color: #1f7a4d; font-weight: 600; }
.checkbox-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { display: flex; align-items: center; justify-content: center; min-height: 80rpx; box-sizing: border-box; padding: 12rpx 24rpx; border: 2rpx solid transparent; border-radius: 999rpx; background: #f4f0eb; color: #4a4e52; font-size: 26rpx; }
.chip-active { background: #eaf4ed; color: #1f7a4d; border-color: #1f7a4d; }

.food-add { flex-direction: column; align-items: stretch; gap: 12rpx; }
.food-field { width: 100%; min-width: 0; }
.food-field-label { display: block; color: #626c68; font-size: 24rpx; margin-bottom: 8rpx; }
.food-field .form-input { width: 100%; }
.add-btn { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 16rpx 0 0; line-height: 1.4; text-align: center; background: #eef4ef; color: #1f7a4d; border: 1rpx solid #b9d6c4; border-radius: 14rpx; font-size: 28rpx; padding: 12rpx 16rpx; }
.food-list { margin-top: 12rpx; }
.food-item { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 16rpx; background: #faf7f4; border-radius: 12rpx; margin-bottom: 8rpx; font-size: 26rpx; color: #4a4e52; }
.del { color: #c56a2b; font-size: 24rpx; padding-left: 16rpx; }

/* 商家菜品直接展示 */
.merchant-dishes { margin-top: 12rpx; }
.dish { display: flex; justify-content: space-between; padding: 14rpx 16rpx; background: #faf7f4; border-radius: 12rpx; margin-bottom: 8rpx; }
.dish-name { font-size: 26rpx; color: #2a2e31; }
.dish-kcal { font-size: 24rpx; color: #1f7a4d; }
.dish-note { font-size: 22rpx; color: #9aa0a6; margin-top: 8rpx; line-height: 1.5; }

.btn-primary { display: flex; align-items: center; justify-content: center; height: 92rpx; border-radius: 999rpx; background: #1f7a4d; color: #fff; font-size: 30rpx; font-weight: 600; box-shadow: 0 10rpx 20rpx rgba(31,122,77,.2); margin-top: 24rpx; }
.btn-primary[disabled] { background: #cdd4d0; box-shadow: none; }
.btn-secondary { display: flex; align-items: center; justify-content: center; height: 84rpx; border-radius: 999rpx; background: #fff; color: #4a4e52; font-size: 28rpx; border: 1rpx solid #e4ddd6; margin-top: 16rpx; }

/* 计划结果 */
.plan-banner { font-size: 22rpx; color: #c56a2b; background: #fdf1e4; border-radius: 14rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; line-height: 1.5; }
.day { padding: 28rpx; }
.day-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16rpx; }
.day-title { font-size: 30rpx; font-weight: 700; color: #2a2e31; }
.day-kcal { font-size: 26rpx; color: #1f7a4d; font-weight: 600; }
.day-target { color: #9aa0a6; font-size: 22rpx; font-weight: 400; }
.meal-block { margin-top: 16rpx; padding-left: 16rpx; border-left: 4rpx solid #b9d6c4; }
.meal-title { font-size: 26rpx; color: #6b7280; margin-bottom: 10rpx; }
.card-inner { background: #faf7f4; border-radius: 14rpx; padding: 20rpx; margin-bottom: 12rpx; }
.food-head { display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; justify-content: space-between; align-items: baseline; }
.food-name { font-size: 28rpx; font-weight: 600; color: #2a2e31; }
.food-grams { font-size: 24rpx; color: #6b7280; }
.raw-tag { color: #9aa0a6; margin-left: 4rpx; }
.food-nutri { display: flex; flex-wrap: wrap; gap: 16rpx; font-size: 22rpx; color: #6b7280; margin-top: 8rpx; }
.food-actions { display: flex; flex-wrap: wrap; gap: 16rpx 24rpx; margin-top: 14rpx; }
.act { font-size: 24rpx; color: #1f7a4d; }
.act.dislike { color: #c56a2b; }
.removed-note { font-size: 22rpx; color: #c56a2b; margin-top: 8rpx; }

.plan-foot { margin-top: 8rpx; }
.disclaimer { font-size: 22rpx; color: #9aa0a6; text-align: center; line-height: 1.6; }

.day-head, .dish, .food-item { flex-wrap: wrap; gap: 12rpx; }
.food-name, .dish-name, .food-item text { overflow-wrap: anywhere; }
.subtitle, .disclaimer, .dish-note { font-size: 24rpx; color: #626c68; }

@media (max-width: 360px) {
  .card, .day { padding: 24rpx; }
  .form-label { flex-basis: 132rpx; }
  .option-row { gap: 8rpx; }
  .opt { padding-left: 4rpx; padding-right: 4rpx; }
  .day-head { align-items: flex-start; }
}
