.container { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.title { font-size: 40rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.subtitle { font-size: 24rpx; color: #888; margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 500; color: #333; margin: 24rpx 0 12rpx; }

.form-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.form-label { font-size: 28rpx; color: #666; width: 180rpx; }
.form-input { flex: 1; height: 72rpx; padding: 0 16rpx; background: #f9f9f9; border-radius: 8rpx; font-size: 28rpx; line-height: 72rpx; }
.picker { flex: 1; height: 72rpx; line-height: 72rpx; padding: 0 16rpx; background: #f9f9f9; border-radius: 8rpx; font-size: 28rpx; }

.option-row { display: flex; gap: 12rpx; flex: 1; }
.opt { flex: 1; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 10rpx; background: #f0f0f0; color: #666; font-size: 26rpx; border: 2rpx solid transparent; }
.opt-active { background: #e8f5e9; color: #2e7d32; border-color: #66bb6a; }

.checkbox-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { padding: 12rpx 24rpx; border-radius: 20rpx; background: #f0f0f0; color: #666; font-size: 26rpx; }
.chip-active { background: #ffe0e0; color: #c62828; }

.btn-primary { background: #4CAF50; color: white; border-radius: 12rpx; font-size: 30rpx; height: 88rpx; line-height: 88rpx; margin-top: 32rpx; }
.btn-secondary { background: #f0f0f0; color: #666; border-radius: 12rpx; font-size: 28rpx; height: 80rpx; line-height: 80rpx; margin-top: 16rpx; }

.summary-row { display: flex; justify-content: space-around; padding: 24rpx 0; border-bottom: 1rpx solid #eee; }
.summary-item { text-align: center; }
.summary-num { display: block; font-size: 48rpx; font-weight: 600; color: #4CAF50; }
.summary-label { font-size: 24rpx; color: #888; }

.day-block { margin-top: 24rpx; padding: 16rpx; background: #f9f9f9; border-radius: 8rpx; }
.day-title { font-size: 30rpx; font-weight: 500; color: #333; margin-bottom: 12rpx; }
.meal-block { margin-top: 16rpx; padding-left: 16rpx; border-left: 4rpx solid #4CAF50; }
.meal-title { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.food-row { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.food-name { color: #666; flex: 1; }
.food-grams { color: #999; margin: 0 16rpx; }
.food-kcal { color: #333; font-weight: 500; }

.disclaimer { font-size: 22rpx; color: #ff9800; padding: 16rpx; background: #fff8e1; border-radius: 8rpx; margin-top: 24rpx; line-height: 1.6; }

/* 饮食范围 / 自定义食物 */
.food-add { gap: 12rpx; }
.food-cat { width: 220rpx; }
.add-btn {
  width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center;
  background: #4CAF50; color: #fff; border-radius: 8rpx; font-size: 34rpx; padding: 0;
}
.food-list { margin-top: 12rpx; }
.food-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 16rpx; background: #f9f9f9; border-radius: 8rpx; margin-bottom: 8rpx; font-size: 26rpx;
}
.food-txt { color: #444; flex: 1; }
.del { color: #d32f2f; font-size: 24rpx; padding-left: 16rpx; }
.food-note { font-size: 22rpx; color: #999; margin-top: 8rpx; line-height: 1.5; }
