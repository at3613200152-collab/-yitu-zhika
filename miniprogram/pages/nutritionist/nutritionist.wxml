<view class="container">
  <view class="page-title">饮食计划</view>

  <!-- 输入表单 -->
  <view class="card" wx:if="{{!plan}}">
    <view class="subtitle">填几项基本信息，为你生成一周饮食参考。这是可调整的建议，不是必须执行的菜单。</view>

    <view class="form-row"><text class="form-label">身高(cm)</text><input class="form-input" type="digit" value="{{height}}" bindinput="onInput" data-key="height" /></view>
    <view class="form-row"><text class="form-label">体重(kg)</text><input class="form-input" type="digit" value="{{weight}}" bindinput="onInput" data-key="weight" /></view>
    <view class="form-row"><text class="form-label">年龄</text><input class="form-input" type="digit" value="{{age}}" bindinput="onInput" data-key="age" /></view>

    <view class="form-row">
      <text class="form-label">性别</text>
      <view class="option-row">
        <button class="opt {{gender === 'male' ? 'opt-active' : ''}}" bindtap="onGenderSelect" data-v="male">男</button>
        <button class="opt {{gender === 'female' ? 'opt-active' : ''}}" bindtap="onGenderSelect" data-v="female">女</button>
      </view>
    </view>

    <view class="form-row">
      <text class="form-label">目标</text>
      <view class="option-row">
        <button class="opt {{goal === 'lose' ? 'opt-active' : ''}}" bindtap="onGoalSelect" data-v="lose">减</button>
        <button class="opt {{goal === 'maintain' ? 'opt-active' : ''}}" bindtap="onGoalSelect" data-v="maintain">维持</button>
        <button class="opt {{goal === 'gain' ? 'opt-active' : ''}}" bindtap="onGoalSelect" data-v="gain">增</button>
      </view>
    </view>

    <view class="section-title">忌口（可选）</view>
    <view class="checkbox-row">
      <view class="chip {{allergies.includes('鸡蛋') ? 'chip-active' : ''}}" bindtap="toggleAllergy" data-v="鸡蛋">鸡蛋</view>
      <view class="chip {{allergies.includes('牛奶') ? 'chip-active' : ''}}" bindtap="toggleAllergy" data-v="牛奶">牛奶</view>
      <view class="chip {{allergies.includes('海鲜') ? 'chip-active' : ''}}" bindtap="toggleAllergy" data-v="海鲜">海鲜</view>
      <view class="chip {{allergies.includes('牛肉') ? 'chip-active' : ''}}" bindtap="toggleAllergy" data-v="牛肉">牛肉</view>
      <view class="chip {{allergies.includes('猪肉') ? 'chip-active' : ''}}" bindtap="toggleAllergy" data-v="猪肉">猪肉</view>
      <view class="chip {{allergies.includes('羊肉') ? 'chip-active' : ''}}" bindtap="toggleAllergy" data-v="羊肉">羊肉</view>
    </view>

    <view class="section-title">饮食范围（可选，商家菜单或自定义）</view>
    <view class="form-row">
      <text class="form-label">饮食范围</text>
      <picker mode="selector" range="{{menuOptions}}" value="{{presetIndex}}" bindchange="onPresetChange">
        <view class="picker">{{menuOptions[presetIndex]}}</view>
      </picker>
    </view>
    <view class="merchant-dishes" wx:if="{{presetIndex > 0 && merchantMenus.length > 0}}">
      <view class="dish" wx:for="{{merchantMenus[presetIndex - 1].products}}" wx:for-item="p" wx:key="product_id">
        <text class="dish-name">{{p.name}}</text>
        <text class="dish-kcal">{{p.kcal_per_100g}} kcal/100g</text>
      </view>
      <view class="dish-note">以上为商家提供菜品（含每100g营养），选中后按这些菜生成计划；每100g营养由商家上传，仅作参考。</view>
    </view>
    <view class="form-row food-add">
      <input class="form-input" placeholder="食物名" value="{{foodFormName}}" bindinput="onFoodField" data-key="foodFormName" />
      <picker class="food-cat" mode="selector" range="{{foodCategoryIds}}" value="{{foodCategoryIndex}}" bindchange="onFoodCategory">
        <view class="picker">{{foodCategoryIds[foodCategoryIndex]}}</view>
      </picker>
    </view>
    <view class="form-row food-add">
      <input class="form-input" type="digit" placeholder="每100g热量" value="{{foodKcal}}" bindinput="onFoodField" data-key="foodKcal" />
      <input class="form-input" type="digit" placeholder="份量(g)" value="{{foodGrams}}" bindinput="onFoodField" data-key="foodGrams" />
      <button class="add-btn" bindtap="addCustomFood">＋</button>
    </view>
    <view class="food-list" wx:if="{{customFoods.length > 0}}">
      <view class="food-item" wx:for="{{customFoods}}" wx:key="index">
        <text>{{item.name}}（{{item.kcal_per_100g}}kcal/100g，{{item.default_grams}}g）</text>
        <text class="del" bindtap="removeCustomFood" data-idx="{{index}}">删除</text>
      </view>
    </view>

    <button class="btn-primary" bindtap="generatePlan" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '生成中…' : '生成一周饮食建议'}}
    </button>
  </view>

  <!-- 计划结果 -->
  <block wx:else>
    <view class="plan-banner">
      AI 建议草案 · 非处方 · 未经营养师审核 · 可按你的习惯调整
    </view>

    <view class="day card" wx:for="{{plan.daily_recipes}}" wx:for-item="day" wx:key="day">
      <view class="day-head">
        <view class="day-title">第 {{day.day}} 天 · {{day.date}}</view>
        <view class="day-kcal">{{day.day_total_kcal}} kcal<text class="day-target"> / 目标 {{day.target_kcal}}</text></view>
      </view>

      <view class="meal-block" wx:for="{{day.meals}}" wx:for-item="meal" wx:for-index="mi" wx:key="meal_name">
        <view class="meal-title">{{mealZh[meal.meal_name] || meal.meal_name}} · {{meal.nutrition.calories}} kcal</view>

        <view class="food card-inner" wx:for="{{meal.foods}}" wx:for-item="f" wx:for-index="fi" wx:key="index">
          <view class="food-head">
            <view class="food-name">{{f.name}}</view>
            <view class="food-grams">{{f.grams}}g<text class="raw-tag" wx:if="{{f.cooked_or_raw}}">（{{f.cooked_or_raw === 'cooked' ? '熟' : f.cooked_or_raw === 'raw' ? '生' : f.cooked_or_raw}}）</text></view>
          </view>
          <view class="food-nutri">
            <text>{{f.nutrition.calories}} kcal</text>
            <text wx:if="{{f.macro_unknown}}">宏量 待确认</text>
            <block wx:else>
              <text>蛋白 {{f.nutrition.protein}}g</text>
              <text>碳水 {{f.nutrition.carb}}g</text>
              <text>脂肪 {{f.nutrition.fat}}g</text>
            </block>
          </view>
          <view class="food-actions">
            <text class="act" bindtap="swapFood" data-day="{{day.day - 1}}" data-meal="{{mi}}" data-food="{{fi}}">换一道</text>
            <text class="act" bindtap="adjustPortion" data-day="{{day.day - 1}}" data-meal="{{mi}}" data-food="{{fi}}">调整份量</text>
            <text class="act dislike" bindtap="dislikeFood" data-day="{{day.day - 1}}" data-meal="{{mi}}" data-food="{{fi}}">不喜欢</text>
          </view>
        </view>

        <view class="removed-note" wx:if="{{meal.removedNote}}">{{meal.removedNote}}</view>
      </view>
    </view>

    <view class="plan-foot">
      <view class="disclaimer">{{plan.disclaimer}}</view>
      <button class="btn-secondary" bindtap="resetPlan">重新生成</button>
    </view>
  </block>
</view>
