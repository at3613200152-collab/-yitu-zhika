<view class="container" wx:if="{{record}}">
  <!-- 图 -->
  <view class="card photo-card">
    <image src="{{record.imagePath}}" mode="aspectFit" class="result-image"></image>
  </view>

  <!-- 识别结果 -->
  <view class="card" wx:if="{{!editing}}">
    <view class="card-head">
      <text class="card-title">识别结果</text>
    </view>

    <view class="hero">
      <view class="hero-cal">{{record.result.calories}}</view>
      <view class="hero-unit">kcal</view>
    </view>
    <view class="hero-sub">
      <text class="cat-chip">{{record.result.category_name || '未知'}}</text>
      <text class="weight">≈ {{record.result.weight}} g</text>
    </view>

    <!-- 多类别置信度 -->
    <view class="probs" wx:if="{{record.result.category_probs && record.result.category_probs.length > 0}}">
      <view class="prob" wx:for="{{record.result.category_probs}}" wx:for-item="c" wx:key="idx">
        <text class="prob-name">{{c.name}}</text>
        <view class="prob-track">
          <view class="prob-fill" style="width: {{c.pct}}%;"></view>
        </view>
        <text class="prob-pct">{{c.pct}}%</text>
      </view>
      <view class="prob-note">按置信度排序的粗类别；混合餐可能含多类，非逐项检测。</view>
    </view>

    <view class="warning" wx:if="{{record.result.model_version}}">
      数据来源：{{record.result.model_version}}（仅供参考，非医疗诊断）
    </view>

    <!-- 完成记录的鼓舞反馈 -->
    <view class="celebrate" wx:if="{{celebrated}}">
      🎉 已记录到你的饮食日记，坚持就是胜利！
    </view>

    <!-- 三档反馈 -->
    <view class="section-title">这个估算准吗？</view>
    <view class="grade-row">
      <button class="grade-btn {{userGrade === 'over' ? 'grade-active-over' : ''}}" bindtap="onGradeSelect" data-grade="over">偏多</button>
      <button class="grade-btn grade-default {{userGrade === 'ok' ? 'grade-active-ok' : ''}}" bindtap="onGradeSelect" data-grade="ok">差不多</button>
      <button class="grade-btn {{userGrade === 'under' ? 'grade-active-under' : ''}}" bindtap="onGradeSelect" data-grade="under">偏少</button>
    </view>
    <view class="hint">点击"差不多"即可快速完成反馈</view>

    <!-- 折叠手动修正 -->
    <view class="manual-toggle" bindtap="toggleManualMode">
      {{showManualForm ? '收起手动修正' : '我手动改…'}}
    </view>
    <view class="manual-form" wx:if="{{showManualForm}}">
      <view class="label">类别</view>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="input">{{editCategory || '请选择'}}</view>
      </picker>
      <view class="label">实际热量 (kcal)</view>
      <input class="input" type="digit" value="{{editCalories}}" bindinput="onCaloriesInput" placeholder="如：250" />
      <view class="label">实际重量 (g)</view>
      <input class="input" type="digit" value="{{editWeight}}" bindinput="onWeightInput" placeholder="如：180" />
      <button class="btn-primary" bindtap="submitManualFeedback">提交手动修正</button>
    </view>

    <view class="skip-row">
      <button class="btn-text" bindtap="skipFeedback">跳过这顿</button>
    </view>
  </view>

  <view class="disclaimer">
    本结果为算法估算，可能存在误差；请以实际食物称重和营养师建议为准。
  </view>
</view>
