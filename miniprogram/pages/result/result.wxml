<view class="container" wx:if="{{record}}">
  <!-- 餐食照片 -->
  <view class="card photo-card">
    <image src="{{record.imagePath}}" mode="aspectFit" class="result-image"></image>
    <view class="badge-est">本页数值均为模型估算</view>
  </view>

  <!-- 识别与确认 -->
  <view class="card">
    <view class="card-title">这一餐</view>

    <view class="cat-row">
      <view class="cat-chip">{{record.result.category_name || '未知类别'}}</view>
      <view class="est-line">估算热量 <text class="big">{{record.result.calories}}</text> kcal</view>
      <view class="est-line">估算份量 <text class="big">{{record.result.weight}}</text> g</view>
    </view>

    <!-- 三大营养素（当前模型不输出 → 待补充，不显示 0） -->
    <view class="macros" wx:if="{{record.result.macros_status === 'unsupported'}}">
      <view class="macros-label">蛋白质 / 碳水 / 脂肪</view>
      <view class="macros-value">暂不支持（当前模型不输出宏量营养）</view>
    </view>
    <view class="macros" wx:elif="{{record.result.protein_g !== undefined && record.result.protein_g !== null}}">
      <view class="macros-label">宏量营养（估算）</view>
      <view class="macro-item">蛋白质 {{record.result.protein_g}} g</view>
      <view class="macro-item">碳水 {{record.result.carbohydrate_g}} g</view>
      <view class="macro-item">脂肪 {{record.result.fat_g}} g</view>
    </view>

    <!-- 多类别置信度（不作为"准确率"） -->
    <view class="probs" wx:if="{{record.result.category_probs && record.result.category_probs.length > 1}}">
      <view class="prob-head">模型最可能的大类（单标签，非各食材占比）</view>
      <view class="prob" wx:for="{{record.result.category_probs}}" wx:for-item="c" wx:key="idx" wx:if="{{c.pct >= 1}}">
        <text class="prob-name">{{c.name}}</text>
        <view class="prob-track"><view class="prob-fill" style="width: {{c.pct}}%;"></view></view>
        <text class="prob-pct">{{c.pct}}%</text>
      </view>
      <view class="prob-note">模型是单标签分类，会把最高置信度的大类压到接近 100%、其它接近 0%——<text class="hl">不代表这餐只有蔬菜</text>；这餐可能同时含蛋类/谷物等，本栏无法判断各食材占比。</view>
    </view>

    <view class="prompt">照片通常难以判断实际份量和用油量，你可以补充信息。</view>

    <!-- 主操作：确认记录 -->
    <button class="btn-primary" bindtap="confirmRecord" disabled="{{confirmed || loading}}">
      {{confirmed ? '已记录' : '确认记录'}}
    </button>

    <!-- 训练授权（默认不勾选，独立于正常使用） -->
    <view class="consent-row" bindtap="toggleConsent">
      <view class="cb {{consent ? 'cb-on' : ''}}">{{consent ? '✓' : ''}}</view>
      <text class="consent-text">我同意将此记录用于改善识别（可选，默认不勾选）</text>
    </view>

    <!-- 次要操作：修改 / 重新选择 -->
    <view class="secondary-row">
      <text class="link" bindtap="toggleManual">{{showManual ? '收起修改' : '修改份量/类别'}}</text>
      <text class="link" bindtap="repick">重新选择照片</text>
    </view>

    <!-- 手动修正表单 -->
    <view class="manual-form" wx:if="{{showManual}}">
      <view class="label">类别</view>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="input">{{editCategory || '请选择'}}</view>
      </picker>
      <view class="label">实际热量 (kcal)</view>
      <input class="input" type="digit" value="{{editCalories}}" bindinput="onCaloriesInput" placeholder="如：250" />
      <view class="label">实际重量 (g)</view>
      <input class="input" type="digit" value="{{editWeight}}" bindinput="onWeightInput" placeholder="如：180" />
      <view class="note">以下为你手动填写的信息，保存后会与你确认的估算区分开。</view>
      <button class="btn-primary" bindtap="submitManual" disabled="{{loading}}">保存我的信息</button>
    </view>

    <!-- 快速反馈（可选） -->
    <view class="grade-block" wx:if="{{!confirmed}}">
      <view class="section-sub">这个估算准吗？</view>
      <view class="grade-row">
        <button class="grade-btn {{userGrade === 'over' ? 'grade-on' : ''}}" bindtap="onGradeSelect" data-grade="over">偏多</button>
        <button class="grade-btn {{userGrade === 'ok' ? 'grade-on' : ''}}" bindtap="onGradeSelect" data-grade="ok">差不多</button>
        <button class="grade-btn {{userGrade === 'under' ? 'grade-on' : ''}}" bindtap="onGradeSelect" data-grade="under">偏少</button>
      </view>
      <view class="grade-hint">点"差不多"即可快速完成，可随时修改。</view>
    </view>

    <!-- 自愿标注（独立、可跳过） -->
    <view class="annotate">
      <view class="annotate-entry" bindtap="toggleAnnotate">{{showAnnotate ? '收起' : '愿意帮助改善识别吗？（可选）'}}</view>
      <view class="annotate-form" wx:if="{{showAnnotate}}">
        <input class="input" placeholder="菜名（如：香菇滑鸡饭）" value="{{annName}}" bindinput="onAnnField" data-key="annName" />
        <input class="input" placeholder="主要食材（可选，逗号分隔）" value="{{annIngredients}}" bindinput="onAnnField" data-key="annIngredients" />
        <input class="input" type="digit" placeholder="称重重量(g，可选)" value="{{annWeight}}" bindinput="onAnnField" data-key="annWeight" />
        <input class="input" placeholder="烹饪方式（可选，如：蒸/炒）" value="{{annCooking}}" bindinput="onAnnField" data-key="annCooking" />
        <view class="ann-photo" bindtap="chooseAnnImage">{{annImage ? '已选择另一角度照片 ✓' : '补充另一角度照片（可选）'}}</view>
        <button class="btn-secondary" bindtap="submitAnnotate">提交（不知道的可留空）</button>
      </view>
      <view class="ann-note">参与与否不影响正常使用；未同意训练的记录不会进入训练池。</view>
    </view>
  </view>

  <!-- 完成反馈 -->
  <view class="celebrate" wx:if="{{celebrating}}">
    🎉 已记录这一餐，坚持记录是了解自己饮食的第一步。
  </view>

  <view class="disclaimer">
    以上为模型估算，仅供参考；无法替代称重或营养师意见。确认记录并非真实摄入。
  </view>
</view>
