/* pages/result/result.wxss - 识别与确认 */
.container { padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); background: #faf7f4; min-height: 100vh; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(74,58,41,.06); }
.photo-card { padding: 16rpx; }
.result-image { width: 100%; height: 420rpx; border-radius: 14rpx; background: #f1ece7; }
.badge-est { text-align: center; font-size: 22rpx; color: #e8833a; margin-top: 12rpx; }

.card-title { font-size: 32rpx; font-weight: 700; color: #2a2e31; margin-bottom: 8rpx; }

.cat-row { display: flex; flex-direction: column; gap: 12rpx; }
.model-chip { align-self: flex-start; padding: 8rpx 20rpx; border-radius: 999rpx; background: #eef4ef; color: #1f7a4d; font-size: 24rpx; font-weight: 600; }
/* 类别来源说明：一行小字，紧跟类别标签，不占视觉重点 */
.cat-note { font-size: 22rpx; color: #9aa0a6; line-height: 1.5; }
.estimate-grid { display: flex; gap: 16rpx; }
.estimate-item { flex: 1; min-width: 0; padding: 18rpx; background: #faf7f4; border-radius: 14rpx; }
.estimate-label { display: block; font-size: 23rpx; color: #6b7280; margin-bottom: 4rpx; }
.big { font-size: 42rpx; font-weight: 800; color: #1f7a4d; }
.unit { margin-left: 6rpx; font-size: 22rpx; color: #6b7280; }

.prob-note { font-size: 22rpx; color: #9aa0a6; margin-top: 8rpx; line-height: 1.5; }

.prompt { font-size: 24rpx; color: #6b7280; margin: 20rpx 0 8rpx; padding: 16rpx 20rpx; background: #faf4ec; border-radius: 12rpx; }

/* 宏量营养（待补充 / 估算） */
.macros { margin-top: 8rpx; padding: 14rpx 18rpx; background: #f6f4f1; border-radius: 12rpx; }
.macros-label { font-size: 24rpx; color: #6b7280; }
.macros-value { font-size: 26rpx; color: #9aa0a6; margin-top: 6rpx; }
.macros-value.warn { color: #e8833a; }
.macro-grid { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.macro-item { flex: 1 1 150rpx; min-width: 0; padding: 12rpx 8rpx; text-align: center; background: #fff; border-radius: 10rpx; }
.macro-name { display: block; font-size: 22rpx; color: #6b7280; }
.macro-number { display: block; margin-top: 2rpx; font-size: 24rpx; color: #2a2e31; font-weight: 600; overflow-wrap: anywhere; }

.btn-primary { display: flex; align-items: center; justify-content: center; height: 92rpx; border-radius: 999rpx; background: #1f7a4d; color: #fff; font-size: 30rpx; font-weight: 600; box-shadow: 0 10rpx 20rpx rgba(31,122,77,.2); margin-top: 20rpx; }
.btn-primary:active { background: #185f3b; }
.btn-primary[disabled] { background: #cdd4d0; box-shadow: none; color: #fff; }

.secondary-row { display: flex; justify-content: space-between; margin-top: 20rpx; }
.link { color: #1f7a4d; font-size: 26rpx; padding: 8rpx; }

.manual-form { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0ece7; }
.label { font-size: 26rpx; color: #6b7280; margin: 16rpx 0 8rpx; }
.input { height: 80rpx; padding: 0 20rpx; background: #faf7f4; border-radius: 14rpx; font-size: 28rpx; line-height: 80rpx; margin-bottom: 12rpx; }
.note { font-size: 22rpx; color: #9aa0a6; line-height: 1.5; margin: 8rpx 0; }

.grade-block { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #f0ece7; }
.section-sub { font-size: 28rpx; color: #4a4e52; margin-bottom: 12rpx; }
.grade-row { display: flex; gap: 16rpx; }
/* 按钮文字居中：用 flex 居中并清掉小程序 button 的默认内边距与 ::after 边框，
   只写 height+line-height 会因组件默认样式导致文字偏下 */
.grade-btn {
  flex: 1; display: flex; align-items: center; justify-content: center;
  height: 76rpx; padding: 0; margin: 0; line-height: 1;
  border-radius: 999rpx; background: #f4f0eb; color: #4a4e52; font-size: 26rpx;
  border: 2rpx solid transparent; box-sizing: border-box;
}
.grade-btn::after { border: none; }
.grade-on { background: #eef4ef; color: #1f7a4d; border-color: #b9d6c4; }
.grade-hint { font-size: 22rpx; color: #9aa0a6; text-align: center; margin-top: 8rpx; }

.celebrate {
  margin-top: 8rpx; padding: 20rpx 24rpx; border-radius: 16rpx;
  background: #eef4ef; color: #1f7a4d; font-size: 28rpx; font-weight: 600; text-align: center;
  animation: pop .4s ease;
}
@keyframes pop { 0% { transform: scale(.92); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }

/* 训练授权 */
.consent-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding: 12rpx 0; }
.cb { width: 40rpx; height: 40rpx; border-radius: 10rpx; border: 2rpx solid #c9d2cc; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #fff; flex-shrink: 0; }
.cb-on { background: #1f7a4d; border-color: #1f7a4d; }
.consent-text { font-size: 24rpx; color: #6b7280; line-height: 1.5; }

/* 自愿标注 */
.annotate { margin-top: 24rpx; }
.annotate-entry { font-size: 26rpx; color: #1f7a4d; text-align: center; padding: 16rpx; border-top: 1rpx dashed #e0e5e1; }
.annotate-form { margin-top: 12rpx; }
.ann-photo { font-size: 26rpx; color: #1f7a4d; text-align: center; padding: 16rpx; background: #f0f4f1; border-radius: 14rpx; margin: 12rpx 0; }
.ann-note { font-size: 22rpx; color: #9aa0a6; text-align: center; margin-top: 12rpx; line-height: 1.5; }

.disclaimer { font-size: 22rpx; color: #9aa0a6; text-align: center; padding: 12rpx 24rpx; line-height: 1.6; }

@media (max-width: 360px) {
  .card { padding: 24rpx; }
  .estimate-grid { flex-direction: column; }
  .macro-item { flex-basis: 100%; }
}
