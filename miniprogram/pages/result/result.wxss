/* pages/result/result.wxss - 三档点击 + 折叠手动改 */
.container { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.result-image { width: 100%; height: 400rpx; border-radius: 12rpx; background: #f0f0f0; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 24rpx; color: #333; }
.label { font-size: 26rpx; color: #888; margin-top: 16rpx; margin-bottom: 8rpx; }
.value { font-size: 40rpx; font-weight: 600; color: #333; }
.warning { font-size: 22rpx; color: #ff9800; margin-top: 16rpx; padding: 12rpx; background: #fff8e1; border-radius: 8rpx; }

/* 三档点击 */
.section-title { font-size: 30rpx; font-weight: 500; color: #333; margin-top: 32rpx; margin-bottom: 16rpx; }
.grade-row { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.grade-btn {
  flex: 1; height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 12rpx; font-size: 28rpx; background: #f0f0f0; color: #666;
  border: 2rpx solid transparent; transition: all 0.2s;
}
.grade-default { background: #e8f5e9; color: #2e7d32; border-color: #a5d6a7; }
.grade-active-over { background: #ffe0e0; color: #c62828; border-color: #ef9a9a; }
.grade-active-ok { background: #c8e6c9; color: #1b5e20; border-color: #66bb6a; }
.grade-active-under { background: #e3f2fd; color: #1565c0; border-color: #90caf9; }
.hint { font-size: 22rpx; color: #999; text-align: center; margin-top: 8rpx; }

/* 折叠手动改 */
.manual-toggle {
  font-size: 26rpx; color: #1976d2; text-align: center; margin-top: 24rpx;
  padding: 16rpx; border-top: 1rpx dashed #ddd;
}
.manual-form { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #eee; }
.input {
  height: 80rpx; padding: 0 16rpx; background: #f9f9f9;
  border-radius: 8rpx; font-size: 28rpx; line-height: 80rpx; margin-bottom: 16rpx;
}

/* 跳过按钮 */
.skip-row { margin-top: 24rpx; text-align: center; }
.btn-text { background: transparent; color: #999; font-size: 24rpx; }

/* 通用按钮 */
.btn-primary {
  background: #4CAF50; color: white; border-radius: 12rpx;
  font-size: 30rpx; height: 88rpx; line-height: 88rpx; margin-top: 16rpx;
}
.btn-secondary {
  background: #f0f0f0; color: #666; border-radius: 12rpx;
  font-size: 28rpx; height: 80rpx; line-height: 80rpx; margin-top: 12rpx;
}
.disclaimer { font-size: 22rpx; color: #999; text-align: center; padding: 24rpx; line-height: 1.6; }
