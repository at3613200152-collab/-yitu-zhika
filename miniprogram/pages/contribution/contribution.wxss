/* pages/contribution/contribution.wxss - 我的 */
.container { padding: 28rpx 24rpx 48rpx; background: #faf7f4; min-height: 100vh; }
.page-title { font-size: 40rpx; font-weight: 700; color: #2a2e31; margin: 8rpx 0 16rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(74,58,41,.06); }

.card-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16rpx; }
.card-title { font-size: 30rpx; font-weight: 700; color: #2a2e31; }
.card-sub { font-size: 22rpx; color: #1f7a4d; }

/* hero */
.hero { display: flex; align-items: center; gap: 24rpx; background: #eef4ef; }
.hero-left { display: flex; flex-direction: column; align-items: center; }
.streak-num { font-size: 64rpx; font-weight: 800; color: #1f7a4d; line-height: 1; }
.streak-unit { font-size: 22rpx; color: #4a4e52; margin-top: 4rpx; }
.hero-right { flex: 1; display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.dots { display: flex; gap: 10rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #d6e2da; }
.dot-on { background: #1f7a4d; }
.hero-note { font-size: 22rpx; color: #4a4e52; }

/* 档案/数据 */
.row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f2eee9; font-size: 28rpx; }
.row:last-child { border-bottom: none; }
.row-label { color: #4a4e52; }
.row-value { color: #2a2e31; }
.row-value.soon { color: #9aa0a6; font-size: 24rpx; }
.row-arrow { color: #9aa0a6; font-size: 32rpx; }
.btn-danger { display: flex; align-items: center; justify-content: center; height: 84rpx; border-radius: 999rpx; background: #fff; color: #c0392b; font-size: 28rpx; border: 1rpx solid #eab5ad; margin-top: 20rpx; }

/* 成就 */
.ach-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.ach { width: calc((100% - 32rpx) / 3); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 18rpx 8rpx; border-radius: 16rpx; font-size: 22rpx; }
.ach-on { background: #eef4ef; color: #1f7a4d; border: 1rpx solid #b9d6c4; }
.ach-off { background: #f6f3ef; color: #a9adb3; }
.ach-emoji { font-size: 42rpx; }
.ach-label { text-align: center; line-height: 1.3; }

/* 反馈统计 */
.stat-row { display: flex; justify-content: space-around; padding: 16rpx 0; border-bottom: 1rpx solid #f2eee9; }
.stat { text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #1f7a4d; }
.stat-label { font-size: 22rpx; color: #6b7280; margin-top: 4rpx; }
.hint-block { font-size: 23rpx; color: #6b7280; margin-top: 16rpx; line-height: 1.6; }

.disclaimer { font-size: 22rpx; color: #9aa0a6; text-align: center; padding: 12rpx 24rpx; line-height: 1.6; }
