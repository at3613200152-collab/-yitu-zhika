.container { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.summary { text-align: center; padding: 48rpx 32rpx; }
.title { font-size: 36rpx; font-weight: 600; color: #333; margin-bottom: 24rpx; }
.stat-row { display: flex; justify-content: space-around; margin: 16rpx 0; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 48rpx; font-weight: 600; color: #4CAF50; }
.stat-label { font-size: 24rpx; color: #888; margin-top: 8rpx; }

.empty { font-size: 32rpx; color: #999; margin-bottom: 16rpx; }
.hint { font-size: 24rpx; color: #aaa; margin-bottom: 24rpx; }
.hint-block { font-size: 24rpx; color: #888; margin-bottom: 24rpx; line-height: 1.6; }
.row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.row:last-child { border-bottom: none; }
.row-label { font-size: 28rpx; color: #666; }
.row-value { font-size: 28rpx; color: #333; }
.dim { color: #999; }
.highlight { color: #2e7d32; font-weight: 500; }

.btn-primary {
  background: #4CAF50; color: white; border-radius: 12rpx;
  font-size: 30rpx; height: 88rpx; line-height: 88rpx; margin-top: 16rpx;
}
.btn-secondary {
  background: #f0f0f0; color: #666; border-radius: 12rpx;
  font-size: 28rpx; height: 80rpx; line-height: 80rpx; margin-top: 16rpx;
}
.disclaimer { font-size: 22rpx; color: #999; text-align: center; padding: 24rpx; line-height: 1.6; }
