.container { padding: 24rpx; background: #f5f5f5; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.title { font-size: 40rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.subtitle { font-size: 24rpx; color: #888; margin-bottom: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 500; color: #333; margin: 24rpx 0 12rpx; }
.hint { font-size: 22rpx; color: #999; margin-top: 8rpx; }

.option-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.opt {
  flex: 1; min-width: 30%; height: 72rpx; line-height: 72rpx; text-align: center;
  border-radius: 10rpx; background: #f0f0f0; color: #666; font-size: 26rpx;
  border: 2rpx solid transparent;
}
.opt-active { background: #e8f5e9; color: #2e7d32; border-color: #66bb6a; }

.checkbox-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 12rpx 24rpx; border-radius: 20rpx; background: #f0f0f0;
  color: #666; font-size: 26rpx;
}
.chip-active { background: #e3f2fd; color: #1565c0; }

.btn-primary {
  background: #4CAF50; color: white; border-radius: 12rpx;
  font-size: 30rpx; height: 88rpx; line-height: 88rpx; margin-top: 24rpx;
}
.btn-text { background: transparent; color: #999; font-size: 24rpx; margin-top: 12rpx; }
