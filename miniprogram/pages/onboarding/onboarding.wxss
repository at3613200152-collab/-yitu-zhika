.subtitle { font-size: 26rpx; color: #626c68; line-height: 1.65; margin-bottom: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin: 32rpx 0 16rpx; }
.hint { font-size: 24rpx; color: #626c68; line-height: 1.6; margin-top: 12rpx; }
.option-row { display: flex; gap: 12rpx; width: 100%; min-width: 0; }
.opt {
  display: flex; align-items: center; justify-content: center;
  flex: 1 1 0%; width: 0; min-width: 0; margin: 0; padding: 12rpx 8rpx;
  min-height: 88rpx; line-height: 1.4; text-align: center;
  border-radius: 14rpx; background: #f4f0eb; color: #4a4e52;
  font-size: 26rpx; font-weight: 500; border: 2rpx solid transparent;
}
.opt-active { background: #eaf4ed; color: #1f7a4d; border-color: #1f7a4d; font-weight: 600; }
.checkbox-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box; min-height: 80rpx; padding: 12rpx 24rpx;
  border-radius: 999rpx; background: #f4f0eb; color: #4a4e52;
  font-size: 26rpx; border: 2rpx solid transparent;
}
.chip-active { background: #eaf4ed; color: #1f7a4d; border-color: #1f7a4d; }
.btn-primary { margin-top: 24rpx; }
.btn-text {
  width: 100%; min-height: 88rpx; display: flex; align-items: center; justify-content: center;
  background: transparent; color: #626c68; font-size: 26rpx; line-height: 1.4; margin-top: 12rpx;
}
