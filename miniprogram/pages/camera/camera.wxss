/* pages/camera/camera.wxss */
.preview {
  width: 100%;
  height: 400rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  overflow: hidden;
}
.preview-img {
  width: 100%;
  height: 100%;
}
.placeholder {
  width: 100%;
  height: 400rpx;
  background: #fff;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
}
.placeholder-text {
  color: #999;
  font-size: 28rpx;
}
.btn-row {
  display: flex;
  justify-content: space-around;
  width: 100%;
  gap: 16rpx;
}
.btn-row .btn-primary {
  flex: 1;
  margin: 8rpx;
}
.submit-btn {
  margin-top: 32rpx;
  width: 100%;
}
