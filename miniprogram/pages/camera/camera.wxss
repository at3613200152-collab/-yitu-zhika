/* pages/camera/camera.wxss */
.preview {
  width: 100%;
  height: 400rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  overflow: hidden;
}
.preview-img {
  width: 100%;
  height: 100%;
}
.placeholder {
  width: 100%;
  height: 400rpx;
  background: #fff;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 20rpx 0;
}
.placeholder-icon {
  width: 88rpx;
  height: 88rpx;
  opacity: .55;
  margin-bottom: 18rpx;
}
.placeholder-text {
  color: #999;
  font-size: 28rpx;
}
.btn-row {
  display: flex;
  align-items: stretch;
  width: 100%;
  gap: 16rpx;
}
.btn-row .btn-primary,
.btn-row .btn-secondary {
  flex: 1;
  width: 0;
  margin: 8rpx 0;
}
.submit-btn {
  margin-top: 32rpx;
  width: 100%;
}
