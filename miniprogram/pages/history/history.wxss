/* pages/history/history.wxss */
.empty {
  margin-top: 200rpx;
  text-align: center;
  color: #999;
}
.history-row {
  display: flex;
  align-items: center;
}
.history-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.history-info {
  flex: 1;
}
.history-cat {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}
.history-kcal {
  font-size: 28rpx;
  color: #4CAF50;
  margin-top: 4rpx;
}
.history-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
