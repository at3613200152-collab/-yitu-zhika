/* pages/history/history.wxss */
.container { padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); background: #faf7f4; min-height: 100vh; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; border: 1rpx solid #f0ece7; box-shadow: 0 4rpx 16rpx rgba(74,58,41,.06); }

/* 打卡摘要 */
.summary { display: flex; align-items: center; gap: 24rpx; }
.summary-left { display: flex; flex-direction: column; align-items: center; }
.sum-num { font-size: 44rpx; font-weight: 800; color: #1f7a4d; }
.sum-label { font-size: 22rpx; color: #86909c; }
.summary-right { flex: 1; display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.dots { display: flex; gap: 10rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #e5e6ea; }
.dot-on { background: #1f7a4d; }
.sum-label2 { font-size: 22rpx; color: #4b5563; }

.empty { text-align: center; color: #86909c; padding: 60rpx 32rpx; font-size: 30rpx; }
.empty-hint { font-size: 24rpx; color: #a9adb3; margin-top: 12rpx; }

/* 记录卡片 */
.record { display: flex; gap: 20rpx; }
.record-thumb { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: #f0f1f4; flex-shrink: 0; }
.record-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
.record-cat { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.cat-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.record-name { min-width: 0; font-size: 28rpx; font-weight: 600; color: #1f2329; overflow-wrap: anywhere; }
.record-grams { font-size: 24rpx; color: #86909c; margin-left: auto; }
.record-kcal { font-size: 40rpx; font-weight: 800; color: #1f7a4d; }
.record-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 16rpx; font-size: 22rpx; color: #7d8581; }
.flag { padding: 2rpx 12rpx; border-radius: 999rpx; background: #eef4ef; color: #1f7a4d; font-size: 22rpx; }
.flag.local { background: #fff4e5; color: #f7a11a; }

.disclaimer { font-size: 22rpx; color: #86909c; text-align: center; padding: 20rpx; line-height: 1.6; }

@media (max-width: 360px) {
  .record { align-items: flex-start; }
  .record-thumb { width: 132rpx; height: 132rpx; }
  .record-kcal { font-size: 34rpx; }
}
