INFERENCE_API_KEY=change-me-strong-random           # 小程序端 app.js 的 apiKey 需与之相同
MERCHANT_API_KEY=change-me-merchant-key             # 商家上传菜单用
ADMIN_API_KEY=change-me-admin-key                   # 审核菜单用

# 微信小程序登录（AppSecret 仅服务器端持有，绝不进小程序代码）
WX_APPID=wxcd827286e262c0ce
WX_SECRET=change-me-wechat-appsecret                # 微信公众平台「开发管理→开发设置」生成
